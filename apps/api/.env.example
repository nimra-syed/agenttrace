# Local Postgres started via `pnpm db:up` (docker compose), mapped to host
# port 5433 — see infra/docker/docker-compose.yml and CLAUDE.md for why.
# This is a local-only dev credential, not a real secret.
DATABASE_URL="postgresql://agenttrace:agenttrace_dev_password@localhost:5433/agenttrace?schema=public"

# Signs the CSRF token (see ADR-0013). Must be at least 32 random bytes,
# hex-encoded (64 hex characters) — the API refuses to start otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=
