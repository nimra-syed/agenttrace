# Must match apps/api's EVAL_WORKER_SECRET exactly (see ADR-0016). At
# least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
EVAL_WORKER_SECRET=

# https://aistudio.google.com/apikey -- same key reference-agent uses
# (ADR-0010), or a separate one; this service never shares a process
# with reference-agent.
GEMINI_API_KEY=

# Optional, defaults to gemini-3-flash-preview (same model
# reference-agent defaults to, ADR-0010's live-tested choice).
GEMINI_MODEL=
