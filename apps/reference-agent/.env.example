# See the root README ("Setting up the reference agent") for how to
# create an AgentTrace project and API key.
AGENTTRACE_API_KEY=atr_your_key_here
AGENTTRACE_BASE_URL=http://localhost:3000

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional, defaults to gemini-3-flash-preview (see llm.ts). Overriding
# this to a model not in pricing.ts's price table means costUsd will be
# omitted (not guessed) for that run. If this model ever stops working,
# check current model availability directly against Gemini's API first
# (see the root README), not by assuming the code is wrong.
GEMINI_MODEL=gemini-3-flash-preview
