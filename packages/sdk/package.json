{
  "name": "@agenttraceai/sdk",
  "version": "0.1.1",
  "description": "Instrumentation client for AgentTrace: record an AI agent's traces and spans.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimra-syed/agenttrace.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js && dts-bundle-generator --no-banner -o dist/index.d.ts src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@agenttraceai/shared-types": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.24.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
