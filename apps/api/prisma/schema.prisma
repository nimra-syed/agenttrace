// AgentTrace data model.
// See docs/adr/0003-trace-span-data-model.md for the reasoning behind
// field choices, ID strategy, and indexes.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MEMBER
}

enum TraceStatus {
  RUNNING
  SUCCESS
  ERROR
}

enum SpanType {
  LLM
  TOOL
  RETRIEVAL
  CUSTOM
}

enum SpanStatus {
  RUNNING
  SUCCESS
  ERROR
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
  projects    Project[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  memberships              Membership[]
  sessions                 Session[]
  installationsCreated     Installation[] @relation("InstallationCreatedBy")
  installationsRevoked     Installation[] @relation("InstallationRevokedBy")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Membership {
  id        String   @id @default(uuid())
  orgId     String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

model Project {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  slug      String
  createdAt DateTime @default(now())

  organization  Organization   @relation(fields: [orgId], references: [id])
  apiKeys       ApiKey[]
  traces        Trace[]
  installations Installation[]

  @@unique([orgId, slug])
}

model ApiKey {
  id         String    @id @default(uuid())
  projectId  String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

// A project-scoped, user-attributed credential, created via the
// browser-based CLI-connect flow rather than typed/copied by hand.
// Distinct from ApiKey (impersonal, admin-provisioned, for
// CI/production/service use) on purpose: an Installation answers "which
// human connected this," ApiKey answers "which system is this for." See
// docs/architecture/cli-onboarding-design.md and ADR-0017.
//
// tokenHash is nullable and starts null: the raw secret is generated at
// token-exchange time, not at browser-approval time, so a raw secret is
// never persisted anywhere, even briefly, matching this project's
// existing rule for every other credential (Session, ApiKey). A row
// with tokenHash still null is what the dashboard later shows as
// "Pending," not "Connected" -- it exists (approved), but nothing has
// actually authenticated with it yet, since a Bearer lookup by hash can
// never match a null column.
model Installation {
  id              String    @id @default(uuid())
  projectId       String
  createdByUserId String
  label           String
  tokenPrefix     String?
  tokenHash       String?   @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime  @default(now())

  project       Project               @relation(fields: [projectId], references: [id])
  createdByUser User                  @relation("InstallationCreatedBy", fields: [createdByUserId], references: [id])
  revokedByUser User?                 @relation("InstallationRevokedBy", fields: [revokedByUserId], references: [id])
  authCode      CliAuthorizationCode?
  traces        Trace[]

  @@index([projectId])
}

// A short-lived, single-use authorization code binding one Installation
// row to the PKCE challenge the requesting CLI generated. codeHash is
// hashed at rest with the same discipline as every other secret in this
// project; the raw code is only ever returned once, in the /cli/authorize
// response. See ADR-0017.
model CliAuthorizationCode {
  id             String    @id @default(uuid())
  codeHash       String    @unique
  installationId String    @unique
  codeChallenge  String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  installation Installation @relation(fields: [installationId], references: [id])
}

model Trace {
  id              String      @id @default(uuid())
  projectId       String
  installationId  String?
  externalTraceId String?
  name            String
  agentName       String
  status          TraceStatus @default(RUNNING)
  input           Json?
  output          Json?
  error           String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMs      Int?
  totalTokens     Int?
  totalCostUsd    Decimal?    @db.Decimal(10, 6)
  metadata        Json?
  createdAt       DateTime    @default(now())

  project      Project       @relation(fields: [projectId], references: [id])
  installation Installation? @relation(fields: [installationId], references: [id])
  spans        Span[]
  evalResults  EvalResult[]

  @@unique([projectId, externalTraceId])
  @@index([projectId, startedAt(sort: Desc)])
  @@index([projectId, status])
}

// One row per evaluation run, append-only: re-evaluating a trace adds a
// new row rather than overwriting the last one, so score history over
// time (e.g. after a prompt/rubric change) is preserved. See ADR-0016.
//
// evaluatorVersion + evaluationInput exist specifically so a historical
// score is explicable later: judgeModel alone can't explain a score if
// the rubric, the snapshot-builder's truncation logic, or the prompt
// template changed since. evaluationInput is the exact bounded snapshot
// actually sent to the judge for this row, not a reference to the
// trace/spans as they exist now (which could themselves have drifted,
// though they're effectively immutable post-ingestion today) or a
// promise that it could be reconstructed later.
model EvalResult {
  id               String   @id @default(uuid())
  traceId          String
  score            Int
  rationale        String
  judgeModel       String
  evaluatorVersion String
  evaluationInput  Json
  createdAt        DateTime @default(now())

  trace Trace @relation(fields: [traceId], references: [id])

  @@index([traceId])
}

model Span {
  id               String     @id @default(uuid())
  traceId          String
  externalSpanId   String?
  parentSpanId     String?
  name             String
  type             SpanType
  status           SpanStatus @default(RUNNING)
  input            Json?
  output           Json?
  model            String?
  provider         String?
  promptTokens     Int?
  completionTokens Int?
  costUsd          Decimal?   @db.Decimal(10, 6)
  error            String?
  startedAt        DateTime
  endedAt          DateTime?
  durationMs       Int?
  metadata         Json?
  createdAt        DateTime   @default(now())

  trace Trace @relation(fields: [traceId], references: [id])

  @@unique([traceId, externalSpanId])
  @@index([traceId])
}
